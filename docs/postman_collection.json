{
  "info": {
    "name": "Blog API - Node (Authors & Posts)",
    "_postman_id": "blog-api-collection-0001",
    "description": "Collection for testing the Blog API (Authors and Posts). Set {{base_url}} to http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Authors",
      "item": [
        {
          "name": "Create Author",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/authors",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authors"
              ]
            },
            "description": "Create a new author. Body requires `name` and unique `email`."
          },
          "response": []
        },
        {
          "name": "List Authors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/authors",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authors"
              ]
            },
            "description": "Get all authors."
          },
          "response": []
        },
        {
          "name": "Get Author by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/authors/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authors",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Get a single author. Replace :id with an actual author id."
          },
          "response": []
        },
        {
          "name": "Update Author",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Updated\",\n  \"email\": \"alice.new@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/authors/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authors",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Update author fields. Use the author's id in the path."
          },
          "response": []
        },
        {
          "name": "Delete Author",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/authors/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authors",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Delete an author. This should cascade-delete their posts."
          },
          "response": []
        },
        {
          "name": "List Posts by Author",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/authors/:id/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "authors",
                ":id",
                "posts"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Get all posts belonging to an author."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My first post\",\n  \"content\": \"Hello world\",\n  \"authorId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Create a post. authorId must reference an existing author."
          },
          "response": []
        },
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "List all posts. You can filter by author via ?authorId=1"
          },
          "response": []
        },
        {
          "name": "List Posts (filter by authorId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts?authorId=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "authorId",
                  "value": "1"
                }
              ]
            },
            "description": "List posts filtered by authorId."
          },
          "response": []
        },
        {
          "name": "Get Post by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Get a single post by id. The response includes the author object."
          },
          "response": []
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"content\": \"Updated content\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/posts/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Update a post's title and/or content."
          },
          "response": []
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Delete a post by id."
          },
          "response": []
        }
      ]
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
